# Lokalna łatka wyłącznie kopii kompilacyjnej Colibri e0db083c.
# Nie zmieniamy vendora. Odrzucamy inny plik wejściowy lub inną zmianę.
function(scalajaca_patch_olmoe input output)
    set(expected_input "f630200cc4222e0e8bfaa178af4c063b4cfe90acc96b89ee50169daefcbc23bf")
    set(expected_output "598210464d936a2bffd4d01a69c4c487ab7d2280f3efee6b6d45b90c4297b3ca")
    get_filename_component(input_absolute "${input}" ABSOLUTE)
    get_filename_component(output_absolute "${output}" ABSOLUTE)
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${input_absolute}" input_identity)
        string(TOLOWER "${output_absolute}" output_identity)
    else()
        set(input_identity "${input_absolute}")
        set(output_identity "${output_absolute}")
    endif()
    if(input_identity STREQUAL output_identity)
        message(FATAL_ERROR "Colibri: nie wolno nadpisywać źródła vendora.")
    endif()
    file(SHA256 "${input_absolute}" input_sha)
    if(NOT input_sha STREQUAL expected_input)
        message(FATAL_ERROR "Colibri: niezgodny SHA-256 wejściowego olmoe.c: ${input_sha}")
    endif()
    file(READ "${input_absolute}" original)
    set(before [=[    int hist_len = np, gen = 0, limited = 1, cancelled = 0;
    char buf[512];]=])
    # Importer ogranicza string do 16 KiB jednostek UTF-16. 4 bajty/jednostkę
    # są zachowawczą granicą UTF-8, także dla added tokens. Oficjalny tokenizer
    # ma token 19979 = 512 spacji. Stare 511 B obcinały go bez błędu.
    # Kotlin nadal odrzuca ramkę >4096 B; nie przepuszcza nadmiernego wyjścia.
    set(after [=[    int hist_len = np, gen = 0, limited = 1, cancelled = 0;
    char buf[65537];]=])
    string(REPLACE "${before}" "" without_match "${original}")
    string(LENGTH "${original}" original_length)
    string(LENGTH "${without_match}" without_length)
    string(LENGTH "${before}" match_length)
    math(EXPR removed "${original_length} - ${without_length}")
    if(NOT removed EQUAL match_length)
        message(FATAL_ERROR "Colibri: łatka wymaga dokładnie jednego znanego fragmentu.")
    endif()
    string(REPLACE "${before}" "${after}" patched "${original}")
    string(SHA256 patched_sha "${patched}")
    if(NOT patched_sha STREQUAL expected_output)
        message(FATAL_ERROR "Colibri: niezgodny SHA-256 poprawionego olmoe.c.")
    endif()
    get_filename_component(output_directory "${output_absolute}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    file(CONFIGURE OUTPUT "${output_absolute}" CONTENT "${patched}" @ONLY NEWLINE_STYLE UNIX)
    file(SHA256 "${output_absolute}" written_sha)
    if(NOT written_sha STREQUAL expected_output)
        message(FATAL_ERROR "Colibri: zapis zmienił bajty łatki.")
    endif()
    file(WRITE "${output_absolute}.sha256" "upstream ${expected_input}\npatched ${expected_output}\n")
endfunction()
